{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["react"],
    "baseUrl": ".",
    "paths": {
      "@peektree/banner": ["../../../../packages/banner/src"],
      "@peektree/banner/react": ["../../../../packages/banner/src/react"],
      "@peektree/vite-plugin": ["../../../../packages/vite-plugin/src"],
      "vite": ["../../../../packages/vite-plugin/node_modules/vite"],
      "vite/*": ["../../../../packages/vite-plugin/node_modules/vite/*"],
      "vite/client": ["../../../../packages/vite-plugin/node_modules/vite/client.d.ts"],
      "@vitejs/plugin-react": ["../../types/react-shim.d.ts"],
      "react": ["../../../../packages/banner/node_modules/@types/react/index.d.ts"],
      "react/jsx-runtime": ["../../../../packages/banner/node_modules/@types/react/jsx-runtime.d.ts"],
      "react-dom": ["../../types/react-shim.d.ts"],
      "react-dom/client": ["../../types/react-shim.d.ts"],
      "@types/react": ["../../../../packages/banner/node_modules/@types/react"]
    },
    "typeRoots": [
      "./node_modules/@types",
      "../../../../packages/banner/node_modules/@types",
      "../../../../packages/vite-plugin/node_modules/@types",
      "../../../../node_modules/@types"
    ]
  },
  "include": ["src", "../../types/react-shim.d.ts", "vite.config.ts"]
}

