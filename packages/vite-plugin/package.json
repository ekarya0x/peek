{
  "name": "@ekarya0x/vite-plugin",
  "version": "0.1.9",
  "description": "Vite plugin for peek - any agent, any branch, one command",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ekarya0x/middleware": "workspace:*",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.10",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "peerDependencies": {
    "vite": "^4.0.0 || ^5.0.0"
  },
  "keywords": [
    "vite",
    "vite-plugin",
    "git",
    "worktree",
    "hot-reload",
    "hmr",
    "ai",
    "agent",
    "dx"
  ],
  "homepage": "https://github.com/ekarya0x/peek",
  "repository": {
    "type": "git",
    "url": "https://github.com/ekarya0x/peek"
  },
  "bugs": "https://github.com/ekarya0x/peek/issues",
  "license": "MIT"
}
