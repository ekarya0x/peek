{
  "name": "@ekarya0x/middleware",
  "version": "0.1.6",
  "description": "Core worktree switching logic for peek - any agent, any branch, one command",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "vitest": "^1.0.0"
  },
  "keywords": [
    "git",
    "worktree",
    "middleware",
    "ai",
    "agent"
  ],
  "homepage": "https://github.com/ekarya0x/peek",
  "repository": {
    "type": "git",
    "url": "https://github.com/ekarya0x/peek"
  },
  "bugs": "https://github.com/ekarya0x/peek/issues",
  "license": "MIT"
}
