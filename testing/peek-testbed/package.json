{
  "name": "peek-testbed",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev:vite": "pnpm --filter peek-test-vite dev",
    "dev:next": "pnpm --filter peek-test-next dev",
    "build": "pnpm -r build",
    "clean": "rm -rf node_modules pnpm-lock.yaml apps/*/node_modules apps/*/dist apps/*/.next",
    "test:quick": "./scripts/quick-suite.sh",
    "quick-suite": "./scripts/quick-suite.sh",
    "screenshot-suite": "node scripts/take-screenshots.js"
  },
  "devDependencies": {
    "playwright": "^1.48.0",
    "typescript": "^5.3.0"
  }
}

